# Copy to .env on EC2 for production (subdomain deploy)
# API is served at https://chataffy.com/api/ (see nginx/nginx.conf)

PORT=9000
NODE_ENV=production
ENVIRONMENT=production

# MongoDB, Redis, OpenAI, Qdrant, SMTP, PayPal — set your production values
# MONGODB_URI=
# REDIS_URL=

# Public site URLs
BASE_URL=https://chataffy.com/
CLIENT_URL=https://dashboard.chataffy.com/
AGENT_URL=https://agent.chataffy.com/
SHOPIFY_APP_LOAD_URL=https://dashboard.chataffy.com/

# Auth cookies work across dashboard / agent / apex
AUTH_COOKIE_DOMAIN=.chataffy.com

# Comma-separated browser origins (no trailing slashes)
CORS_ORIGINS=https://chataffy.com,https://www.chataffy.com,https://dashboard.chataffy.com,https://agent.chataffy.com

# Shopify / BigCommerce callbacks use BASE_URL + api/...
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=

# JWT_SECRET_KEY=
# OPENAI_API_KEY=
# Tiered chat models (brief Q&A vs list/catalog/complex)
OPENAI_CHAT_MODEL_PREMIUM=gpt-4.1
OPENAI_CHAT_MODEL_BRIEF=gpt-4.1-mini
OPENAI_ROUTER_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
# Cost tuning (optional)
# USE_LIGHTWEIGHT_RESPONSES=true
# CHAT_HISTORY_LIMIT=8
# CHAT_HISTORY_LIMIT_BRIEF=5
# RAG_MAX_CONTEXT_CHARS=6000
# RAG_MAX_CONTEXT_CHARS_BRIEF=4000
# RAG_MAX_CONTEXT_CHARS_LIST=12000
# RAG_MAX_CONTEXT_CHARS_LINKS=3000
# RAG_MAX_CHUNK_CHARS=1200
# RAG_MAX_CHUNK_CHARS_BRIEF=1000
# RAG_MAX_CHUNK_CHARS_LIST=800
# RAG_LIST_MAX_URLS=30
# RAG_KEYWORD_FETCH_MAX=120
# LOW_RETRIEVAL_SCORE_PREMIUM=0.35=

# Visitor geo lookup (same token as frontend IPINFO_URL)
# IPINFO_TOKEN=your_ipinfo_token
